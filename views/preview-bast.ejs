<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Serah Terima Selesai - TIK Universitas</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
    </style>
</head>
<body class="bg-[#fafafa] min-h-screen flex items-center justify-center p-6 text-[#262626]">
    
    <div class="max-w-lg w-full bg-white border border-[#d9d9d9] rounded-2xl shadow-xl p-8 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-2 bg-[#e62129]"></div>

        <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-green-100 mb-5 shadow-sm">
            <svg class="h-10 w-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h1 class="text-2xl font-bold text-green-600 mb-2">Proses Selesai!</h1>
        
        <p class="text-[15px] text-[#595959] mb-6 leading-relaxed">
            Terima kasih, <span class="font-bold text-[#262626]"><%= user.nama %></span>. Proses serah terima perangkat aset IT telah berhasil direkam secara digital.
        </p>

        <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 mb-6 text-left flex items-start gap-3 shadow-sm">
            <div class="bg-blue-100 p-2 rounded-lg shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
            </div>
            <div>
                <h3 class="font-semibold text-blue-900 text-sm">Dokumen BAST Terkirim</h3>
                <p class="text-xs text-blue-800 mt-1 leading-relaxed">
                    Salinan resmi dokumen Berita Acara Serah Terima (PDF) telah dikirimkan ke email Anda: <br>
                    <strong class="text-blue-900 text-sm"><%= user.email %></strong>
                </p>
            </div>
        </div>

        <div class="text-left bg-[#f9f9f9] border border-[#e5e5e5] rounded-xl p-5 mb-8">
            <h3 class="font-bold text-xs uppercase tracking-wider text-[#8c8c8c] border-b border-[#e5e5e5] pb-2 mb-3">Ringkasan Transaksi</h3>
            
            <div class="space-y-3 text-sm">
                <div>
                    <span class="block text-xs text-[#8c8c8c] mb-0.5">Laptop Baru (Diterima):</span>
                    <span class="font-semibold text-[#262626]"><%= user.model_baru || 'Aset Universitas' %></span> 
                    <span class="text-xs font-mono bg-white px-1.5 py-0.5 border border-[#d9d9d9] rounded text-[#e62129] ml-1"><%= user.sn_baru %></span>
                </div>
                
                <div>
                    <span class="block text-xs text-[#8c8c8c] mb-0.5">Laptop Lama (Diserahkan):</span>
                    <span class="font-medium text-[#595959]"><%= user.model_lama %></span>
                    <span class="text-xs font-mono bg-white px-1.5 py-0.5 border border-[#d9d9d9] rounded text-[#595959] ml-1"><%= user.sn_lama %></span>
                </div>
                
                <% if (items && items.length > 0) { %>
                <div>
                    <span class="block text-xs text-[#8c8c8c] mb-0.5">Kelengkapan Lama Diserahkan:</span>
                    <span class="font-medium text-[#595959]"><%= items.join(', ') %></span>
                </div>
                <% } %>
            </div>
        </div>

        <a href="/" class="inline-flex h-12 items-center justify-center rounded-lg bg-[#e62129] text-white text-sm font-bold transition-all hover:bg-[#ca161c] shadow-md shadow-red-200 uppercase tracking-wide w-full">
            Kembali ke Beranda
        </a>

    </div>

</body>
</html>