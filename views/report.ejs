<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laporan Manajerial Distribusi Laptop - TIK Universitas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .report-card { background: white; padding: 40px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); margin-top: 30px; }
        .card-stats { border-radius: 10px; border: none; transition: transform 0.2s; }
        .card-stats:hover { transform: translateY(-5px); }
        .stat-icon { font-size: 2rem; opacity: 0.3; }

    </style>
</head>
<body>

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mt-4">
        <a href="/admin" class="btn btn-outline-secondary btn-sm">
            &larr; Kembali ke Dashboard Admin
        </a>
        
        <a href="/download-laporan-pdf" class="btn btn-danger fw-bold shadow-sm px-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-pdf-fill me-2 mb-1" viewBox="0 0 16 16">
                <path d="M5.523 12.424c.14-.082.293-.162.459-.238a7.878 7.878 0 0 1-.45.606c-.28.337-.498.516-.635.572a.266.266 0 0 1-.298-.045.285.285 0 0 1-.067-.41c.226-.32.631-.48 1.05-.485zM.5 14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2a2 2 0 0 0-2 2v12zM8.5 2v4a1 1 0 0 0 1 1h4v7a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h6.5z"/>
            </svg>
            Download Laporan PDF
        </a>
    </div>

    <div class="report-card">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-1">LAPORAN REKAPITULASI DISTRIBUSI LAPTOP</h2>
            <p class="text-muted uppercase mb-0">Divisi Teknologi Informasi dan Komunikasi (TIK) Universitas</p>
            <div style="height: 3px; width: 60px; background: #0d6efd; margin: 15px auto;"></div>
        </div>

        <div class="row g-3 mb-5">
            <div class="col-md-4">
                <div class="card card-stats bg-primary text-white p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="d-block">Total Terdistribusi</small>
                            <h3 class="fw-bold mb-0"><%= total %> Unit</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-stats bg-success text-white p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="d-block">Selesai Tanda Tangan</small>
                            <h3 class="fw-bold mb-0"><%= selesai %> Unit</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-stats bg-warning text-dark p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="d-block">Menunggu Konfirmasi</small>
                            <h3 class="fw-bold mb-0"><%= pending %> Unit</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th width="15%">Pegawai</th>
                        <th width="13%">Waktu Transaksi</th>
                        <th width="17%">Perangkat Lama</th>
                        <th width="15%">Kelengkapan Lama</th> 
                        <th width="15%">Perangkat Baru</th>
                        <th width="13%" class="text-center">Status</th>
                        <th width="12%" class="text-center">Dokumen BAST</th>
                    </tr>
                </thead>
                <tbody>
        <% transactions.forEach(row => { %>
        <tr>
            <td>
                <div class="fw-bold"><%= row.nama %></div>
                <div class="text-muted small" style="font-size: 10px;">NIP: <%= row.nip %></div>
            </td>

            <td>
                <div class="text-dark small fw-semibold">
                    <%= row.tanggal_terima ? new Date(row.tanggal_terima).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : '-' %>
                </div>
            </td>

            <td>
                <div class="text-dark fw-semibold small"><%= row.model_lama || '-' %></div>
                <div class="text-muted small" style="font-size: 11px;">SN: <%= row.sn_lama || 'Belum diinput' %></div>
            </td>

            <td>
                <div class="d-flex flex-column gap-1" style="font-size: 11px;">
                    <div>
                        <span class="text-muted">Charger:</span> 
                        <% if (row.charger_is_exist === 1) { %>
                            <span class="badge bg-success" style="font-size: 9px;">Ada</span>
                        <% } else { %>
                            <span class="badge bg-danger" style="font-size: 9px;">Tidak</span>
                        <% } %>
                    </div>
                    <div>
                        <span class="text-muted">Tas Laptop:</span> 
                        <% if (row.bag_is_exist === 1) { %>
                            <span class="badge bg-success" style="font-size: 9px;">Ada</span>
                        <% } else { %>
                            <span class="badge bg-danger" style="font-size: 9px;">Tidak</span>
                        <% } %>
                    </div>
                </div>
            </td>

            <td>
                <div class="text-dark fw-semibold small"><%= row.model_baru || '-' %></div>
                <div class="text-primary small fw-bold" style="font-size: 11px;">SN: <%= row.sn_baru || 'Belum diinput' %></div>
            </td>

            <td class="text-center">
                <% if (row.status === 'Signed') { %>
                    <span class="badge bg-success w-100 py-2">Selesai (TTD)</span>
                <% } else if (row.status === 'Completed') { %>
                    <span class="badge bg-warning text-dark w-100 py-2">Tunggu TTD</span>
                <% } else if (row.status === 'Verified_by_User') { %>
                    <span class="badge bg-info text-dark w-100 py-2">Tunggu Approve</span>
                <% } else { %>
                    <span class="badge bg-secondary w-100 py-2"><%= row.status %></span>
                <% } %>
            </td>

            <td class="text-center">
                <% if (row.status === 'Signed') { %>
                    <a href="/download-pdf/<%= row.nip %>" class="btn btn-sm btn-danger text-white fw-bold w-100" style="font-size: 10px;">
                        Download
                    </a>
                <% } else { %>
                    <span class="text-muted" style="font-size: 10px;">Belum Tersedia</span>
                <% } %>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>
        </div>

        <div class="mt-5 row text-center">
            <div class="col-8"></div>
            <div class="col-4">
                <p class="mb-5">Mengetahui,<br><strong>Manager TIK Division</strong></p>
                <br>
                <p class="mt-4 border-top d-inline-block px-4">( Meredita Susanty )</p>
            </div>
        </div>
    </div>
</div>

</body>
</html>