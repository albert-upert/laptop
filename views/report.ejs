<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laporan Manajerial Distribusi Laptop - ICT Universitas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .report-card { background: white; padding: 40px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); margin-top: 30px; }
        .card-stats { border-radius: 10px; border: none; transition: transform 0.2s; }
        .card-stats:hover { transform: translateY(-5px); }
        .stat-icon { font-size: 2rem; opacity: 0.3; }
        
        /* Pengaturan Cetak */
        @media print {
            .no-print { display: none !important; }
            body { background-color: white; }
            .report-card { box-shadow: none; border: none; padding: 0; }
            .table-dark { background-color: #343a40 !important; color: white !important; }
        }

        .bg-signed { background-color: #f0fdf4 !important; } /* Hijau sangat muda untuk data selesai */
        code { color: #d63384; font-weight: bold; }
    </style>
</head>
<body>

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mt-4 no-print">
        <a href="/admin" class="btn btn-outline-secondary btn-sm">
            &larr; Kembali ke Dashboard Admin
        </a>
        <button onclick="window.print()" class="btn btn-primary shadow-sm">
            Cetak Laporan Resmi (PDF)
        </button>
    </div>

    <div class="report-card">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-1">LAPORAN REKAPITULASI DISTRIBUSI LAPTOP</h2>
            <p class="text-muted uppercase mb-0">Divisi Teknologi Informasi dan Komunikasi (ICT) Universitas</p>
            <div style="height: 3px; width: 60px; background: #0d6efd; margin: 15px auto;"></div>
        </div>

        <div class="row g-3 mb-5">
            <div class="col-md-4">
                <div class="card card-stats bg-primary text-white p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="d-block">Total Terdistribusi</small>
                            <h3 class="fw-bold mb-0"><%= total %> Unit</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-stats bg-success text-white p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="d-block">Selesai Tanda Tangan</small>
                            <h3 class="fw-bold mb-0"><%= selesai %> Unit</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-stats bg-warning text-dark p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="d-block">Menunggu Konfirmasi</small>
                            <h3 class="fw-bold mb-0"><%= pending %> Unit</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th style="width: 50px;">No</th>
                        <th>Waktu Input</th>
                        <th>Karyawan (NIP)</th>
                        <th>Model Perangkat</th>
                        <th>SN Lama</th>
                        <th>SN Baru</th>
                        <th>Status</th>
                        <th class="no-print">Dokumen</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (transactions.length === 0) { %>
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Belum ada data distribusi tercatat.</td>
                        </tr>
                    <% } %>

                    <% transactions.forEach((row, index) => { %>
                    <tr class="<%= row.status === 'Signed' ? 'bg-signed' : '' %>">
                        <td class="text-center"><%= index + 1 %></td>
                        <td><small><%= row.waktu_lokal %></small></td>
                        <td>
                            <div class="fw-bold"><%= row.nama %></div>
                            <small class="text-muted"><%= row.nip %></small>
                        </td>
                        <td><%= row.model_lama %></td>
                        <td><code><%= row.sn_lama %></code></td>
                        <td><code><%= row.sn_baru %></code></td>
                        <td class="text-center">
                            <% if (row.status === 'Signed') { %>
                                <span class="badge bg-success text-white">Signed</span>
                            <% } else { %>
                                <span class="badge bg-warning text-dark">Pending TTD</span>
                            <% } %>
                        </td>
                        <td class="text-center no-print">
                            <% if (row.status === 'Signed') { %>
                                <a href="/preview-bast/<%= row.nip %>" class="btn btn-sm btn-info text-white fw-bold">
                                    Lihat BAST
                                </a>
                            <% } else { %>
                                <span class="text-muted small">N/A</span>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <div class="mt-5 row text-center">
            <div class="col-8"></div>
            <div class="col-4">
                <p class="mb-5">Mengetahui,<br><strong>Manager ICT Division</strong></p>
                <br>
                <p class="mt-4 border-top d-inline-block px-4">( Meredita Susanty )</p>
            </div>
        </div>
    </div>
</div>

</body>
</html>