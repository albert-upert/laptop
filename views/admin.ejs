<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Verifikasi ICT - Universitas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { 
            background-color: #fafafa; 
            font-family: 'Poppins', sans-serif; 
            color: #262626; 
        }
        .table-container { 
            background: white; 
            padding: 30px; 
            border-radius: 12px; 
            border: 1px solid #d9d9d9;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05); 
        }
        /* Header Tabel sesuai gaya Navbar Gradient universitas */
        .table thead { 
            background: linear-gradient(to bottom, #ffffff, #ffeced); 
            border-bottom: 2px solid #e62129;
        }
        .table thead th {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #8c8c8c;
            padding: 15px;
        }
        .input-ict {
            border: 1px solid #d9d9d9;
            font-size: 13px;
            transition: all 0.2s ease-in-out;
        }
        .input-ict:focus {
            border-color: #e62129;
            box-shadow: 0 0 0 3px rgba(230, 33, 41, 0.1);
            outline: none;
        }
        .btn-primary-ict {
            background-color: #e62129;
            border: none;
            font-weight: 700;
            font-size: 12px;
            letter-spacing: 1px;
            transition: 0.3s;
        }
        .btn-primary-ict:hover {
            background-color: #ca161c;
            transform: translateY(-1px);
        }
    </style>
</head>
<body class="py-5">
    <div class="container-fluid px-5">
        <div class="table-container">
            <div class="d-flex justify-content-between align-items-center mb-5 border-b pb-3">
                <div>
                    <h2 class="fw-bold text-dark mb-1">Manajemen Pengambilan Aset</h2>
                    <p class="text-muted small mb-0 uppercase tracking-widest">ICT Universitas Division - Verifikasi Fisik</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/manager-report" class="btn btn-outline-secondary btn-sm px-4 fw-bold">Laporan</a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th width="18%">Pegawai</th>
                            <th width="18%">Model Laptop</th>
                            <th width="24%">Verifikasi SN LAMA (Edit)</th>
                            <th width="24%">Input SN BARU</th>
                            <th width="16%" class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% transactions.forEach(row => { %>
                        <tr>
                            <td>
                                <div class="fw-bold"><%= row.nama %></div>
                                <div class="text-muted small" style="font-size: 11px;">NIP: <%= row.nip %></div>
                            </td>
                            <td>
                                <div class="text-dark fw-semibold"><%= row.model_lama %></div>
                                <span class="badge bg-info text-white" style="font-size: 10px;">Verified by User</span>
                            </td>

                            <form action="/approve/<%= row.id %>" method="POST">
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <input type="text" name="sn_lama" 
                                               class="form-control form-control-sm input-ict fw-bold" 
                                               value="<%= row.sn_lama %>" 
                                               placeholder="SN Lama..." required>
                                        <small class="text-muted italic" style="font-size: 10px;">*Verifikasi dengan fisik perangkat</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <input type="text" name="sn_baru" 
                                               class="form-control form-control-sm input-ict fw-bold text-primary" 
                                               placeholder="Input SN Baru..." required>
                                        <small class="text-primary fw-bold" style="font-size: 10px;">Ready for Distribution</small>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button type="submit" class="btn btn-primary-ict text-white w-100 py-2 shadow-sm">
                                        APPROVE & CETAK
                                    </button>
                                </td>
                            </form>
                        </tr>
                        <% }) %>
                        
                        <% if (transactions.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted italic">
                                Belum ada antrean verifikasi dari karyawan.
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        
        <p class="text-center mt-4 text-muted small uppercase tracking-widest" style="font-size: 9px;">
            Sistem Informasi Inventaris © 2026 - Digital Transformation Office
        </p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>