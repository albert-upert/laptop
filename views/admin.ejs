<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Verifikasi ICT - Universitas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { background-color: #fafafa; font-family: 'Poppins', sans-serif; color: #262626; }
        .table-container { background: white; padding: 30px; border-radius: 12px; border: 1px solid #d9d9d9; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .table thead { background: linear-gradient(to bottom, #ffffff, #ffeced); border-bottom: 2px solid #e62129; }
        .table thead th { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #8c8c8c; padding: 15px; }
        .input-ict { border: 1px solid #d9d9d9; font-size: 12px; }
        .input-ict:focus { border-color: #e62129; box-shadow: 0 0 0 3px rgba(230, 33, 41, 0.1); outline: none; }
        .btn-primary-ict { background-color: #e62129; border: none; font-weight: 700; font-size: 11px; transition: 0.3s; }
        .btn-primary-ict:hover { background-color: #ca161c; }
    </style>
</head>
<body class="py-5">
    <div class="container-fluid px-5">
        <div class="table-container">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3">
                <div>
                    <h2 class="fw-bold text-dark mb-1">Manajemen Pengambilan Aset</h2>
                    <p class="text-muted small mb-0 uppercase tracking-widest">ICT Universitas Division - Verifikasi Fisik</p>
                </div>
                <a href="/manager-report" class="btn btn-outline-secondary btn-sm px-4 fw-bold">Laporan</a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th width="15%">Pegawai</th>
                            <th width="15%">Laptop Lama</th>
                            <th width="20%">Model Baru (Pilih)</th>
                            <th width="20%">Verifikasi SN Lama</th>
                            <th width="20%">Input SN Baru</th>
                            <th width="10%" class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% transactions.forEach(row => { %>
                        <tr>
                            <td>
                                <div class="fw-bold"><%= row.nama %></div>
                                <div class="text-muted small" style="font-size: 10px;">NIP: <%= row.nip %></div>
                            </td>
                            <td>
                                <div class="text-dark fw-semibold small"><%= row.model_lama %></div>
                            </td>

                            <form action="/approve/<%= row.id %>" method="POST">
                                <td>
                                    <select name="model_baru" class="form-select form-select-sm input-ict fw-bold" required>
                                        <option value="" disabled selected>Pilih Model...</option>
                                        <option value="MacBook Pro M3 14-inch">MacBook Pro M3 14-inch</option>
                                        <option value="MacBook Air M3 13-inch">MacBook Air M3 13-inch</option>
                                        <option value="Dell Latitude 5440">Dell Latitude 5440</option>
                                        <option value="Lenovo ThinkPad X1 Carbon Gen 11">Lenovo ThinkPad X1 Carbon Gen 11</option>
                                        <option value="HP EliteBook 840 G10">HP EliteBook 840 G10</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="text" name="sn_lama" class="form-control form-control-sm input-ict fw-bold" value="<%= row.sn_lama %>" required>
                                </td>
                                <td>
                                    <input type="text" name="sn_baru" class="form-control form-control-sm input-ict fw-bold text-primary" placeholder="SN Baru..." required>
                                </td>
                                <td class="text-center">
                                    <button type="submit" class="btn btn-primary-ict text-white w-100 py-2 shadow-sm uppercase">Approve</button>
                                </td>
                            </form>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>