<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Verifikasi ICT - Universitas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { background-color: #fafafa; font-family: 'Poppins', sans-serif; color: #262626; }
        .table-container { background: white; padding: 30px; border-radius: 12px; border: 1px solid #d9d9d9; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .table thead { background: linear-gradient(to bottom, #ffffff, #ffeced); border-bottom: 2px solid #e62129; }
        .table thead th { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #8c8c8c; padding: 15px; }
        .input-ict { border: 1px solid #d9d9d9; font-size: 12px; }
        .input-ict:focus { border-color: #e62129; box-shadow: 0 0 0 3px rgba(230, 33, 41, 0.1); outline: none; }
        .btn-primary-ict { background-color: #e62129; border: none; font-weight: 700; font-size: 11px; transition: 0.3s; }
        .btn-primary-ict:hover:not(:disabled) { background-color: #ca161c; }
        .btn-primary-ict:disabled { background-color: #f5a3a5; cursor: not-allowed; }
    </style>
</head>
<body class="py-5">
    <div class="container-fluid px-5">
        <div class="table-container">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h2 class="fw-bold text-dark mb-1">Manajemen Pengambilan Aset</h2>
                    <p class="text-muted small mb-0 uppercase tracking-widest">ICT Universitas Division - Verifikasi Fisik</p>
                </div>
                <a href="/manager-report" class="btn btn-outline-secondary btn-sm px-4 fw-bold">Laporan</a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th width="15%">Pegawai</th>
                            <th width="15%">Laptop Lama</th>
                            <th width="15%">Status Serah Lama</th> <th width="18%">Model Baru (Pilih)</th>
                            <th width="15%">Verifikasi SN Lama</th>
                            <th width="15%">Input SN Baru</th>
                            <th width="10%" class="text-center">Aksi Final</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% transactions.forEach(row => { %>
                        <tr>
                            <td>
                                <div class="fw-bold"><%= row.nama %></div>
                                <div class="text-muted small" style="font-size: 10px;">NIP: <%= row.nip %></div>
                            </td>
                            
                            <td>
                                <div class="text-dark fw-semibold small"><%= row.model_lama %></div>
                            </td>

                            <td class="text-center">
                                <% if (row.ml_is_handed_over) { %>
                                    <span class="badge bg-success mb-1">Sudah Diterima</span><br>
                                    <span class="text-muted" style="font-size: 9px;"><%= row.tanggal_serah ? new Date(row.tanggal_serah).toLocaleString('id-ID') : '' %></span>
                                <% } else { %>
                                    <form action="/admin/konfirmasi-lama/<%= row.id %>" method="POST">
                                        <button type="submit" class="btn btn-sm btn-warning fw-bold text-dark w-100" style="font-size: 10px;">Konfirmasi Serah</button>
                                    </form>
                                <% } %>
                            </td>

                            <td>
                                <select name="model_baru" form="approve-<%= row.id %>" class="form-select form-select-sm input-ict fw-bold" required <%= !row.ml_is_handed_over ? 'disabled' : '' %>>
                                    <option value="" disabled selected>Pilih Model...</option>
                                    <option value="MacBook Pro M3 14-inch">MacBook Pro M3 14-inch</option>
                                    <option value="MacBook Air M3 13-inch">MacBook Air M3 13-inch</option>
                                    <option value="Dell Latitude 5440">Dell Latitude 5440</option>
                                </select>
                            </td>
                            <td>
                                <input type="text" name="sn_lama" form="approve-<%= row.id %>" class="form-control form-control-sm input-ict fw-bold" value="<%= row.sn_lama %>" required <%= !row.ml_is_handed_over ? 'readonly' : '' %>>
                            </td>
                            <td>
                                <input type="text" name="sn_baru" form="approve-<%= row.id %>" class="form-control form-control-sm input-ict fw-bold text-primary" placeholder="SN Baru..." required <%= !row.ml_is_handed_over ? 'disabled' : '' %>>
                            </td>
                            <td class="text-center">
                                <form id="approve-<%= row.id %>" action="/approve/<%= row.id %>" method="POST">
                                    <button type="submit" class="btn btn-primary-ict text-white w-100 py-2 shadow-sm uppercase" <%= !row.ml_is_handed_over ? 'disabled' : '' %>>
                                        Approve
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>